<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <BuildDependsOn>
      $(BuildDependsOn);
      L10n
    </BuildDependsOn>
  </PropertyGroup>

  <PropertyGroup>
    <_L10nBuildTask>$(MSBuildThisFileDirectory)MN.L10n.BuildTasks.dll</_L10nBuildTask>
    <_L10nDotnetHost>$(DOTNET_HOST_PATH)</_L10nDotnetHost>
    <_L10nDotnetHost Condition="'$(_L10nDotnetHost)' == ''">dotnet</_L10nDotnetHost>
  </PropertyGroup>

  <Target Name="L10n" AfterTargets="AfterBuild" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="&quot;$(_L10nDotnetHost)&quot; &quot;$(_L10nBuildTask)&quot; &quot;$(ProjectDir)&quot;">
    </Exec>
  </Target>
</Project> 